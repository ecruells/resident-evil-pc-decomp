set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR mips64r5900el)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
if(NOT DEFINED ENV{PS2DEV} OR NOT DEFINED ENV{PS2SDK})
    message(FATAL_ERROR "Set PS2DEV and PS2SDK to the installed ps2dev toolchain")
endif()
set(CMAKE_C_COMPILER "$ENV{PS2DEV}/ee/bin/mips64r5900el-ps2-elf-gcc")
set(CMAKE_CXX_COMPILER "$ENV{PS2DEV}/ee/bin/mips64r5900el-ps2-elf-g++")
set(CMAKE_FIND_ROOT_PATH "$ENV{PS2SDK}" "$ENV{PS2SDK}/ports")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(RE1_PS2 ON CACHE BOOL "Build for PlayStation 2")
